# Server-only Binance Stocks Trading Market Data credential.
# Obtain it from your Binance account and configure it in the deployment secret store.
# Never prefix this variable with NEXT_PUBLIC_.
BINANCE_API_KEY=

# Server-only credentials issued by the separate Binance Web3 Developer Portal.
# Both are required to sign RWA Data API requests. Never prefix with NEXT_PUBLIC_.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_SECRET_KEY=

# Optional server-only override. When empty, Monad Network Pulse uses the
# official public mainnet endpoint https://rpc.monad.xyz (chain ID 143).
# Never expose a credential-bearing RPC URL with a NEXT_PUBLIC_ prefix.
MONAD_RPC_URL=
